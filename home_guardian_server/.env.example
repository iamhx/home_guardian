# Home Guardian Server — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# ESP32 serial connection
ESP32_PORT=/dev/ttyUSB0
ESP32_BAUD=115200

# Server binding (127.0.0.1 = localhost only; 0.0.0.0 = all interfaces)
SERVER_HOST=127.0.0.1
SERVER_PORT=8234

# CORS allowed origins (comma-separated; leave empty to deny all cross-origin)
CORS_ORIGINS=

# Picovoice wake word (optional)
PICOVOICE_ACCESS_KEY=
WAKE_WORD_KEYWORD_FILES=
WAKE_WORD_DEVICE_INDEX=

# Firebase Cloud Messaging (optional)
FIREBASE_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=home-guardian_firebase.json
